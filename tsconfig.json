{
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "skipLibCheck": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "downlevelIteration": true,
        "jsx": "react-jsx",
        "useDefineForClassFields": true,
        "baseUrl": "src",
        "paths": {
            "@/*": ["*"],
            "@components": ["components"],
            "@msg": ["components/msg"],
            "@icons": ["components/icons"],
            "@assets/*": ["assets/*"],
            "@hooks": ["hooks"],
            "@models": ["models"],
            "@screens/*": ["screens/*"],
            "@styles": ["styles"],
            "@utils/*": ["utils/*"],
            "@contexts": ["contexts"],
            "@recoil/*": ["recoil/*"],
            "@graphql": ["graphql"],
            "@configs": ["configs"],
            "@configs/*": ["configs/*"],
            "@graphql/*": ["graphql/*"],
            "@graphql/types": ["graphql/types"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "declarations.d.ts", "vite.config.ts"],
    "exclude": ["node_modules"]
}
