{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "downlevelIteration": true,
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "@components": ["src/components"],
      "@msg": ["src/components/msg"],
      "@icons": ["src/components/icons"],
      "@assets/*": ["src/assets/*"],
      "@hooks": ["src/hooks"],
      "@models": ["src/models"],
      "@screens/*": ["src/screens/*"],
      "@public/*": ["public/*"],
      "@styles": ["src/styles"],
      "@utils/*": ["src/utils/*"],
      "@contexts": ["src/contexts"],
      "@recoil/*": ["src/recoil/*"],
      "@graphql": ["src/graphql"],
      "@configs": ["src/configs"],
      "@configs/*": ["src/configs/*"],
      "@graphql/*": ["src/graphql/*"],
      "@graphql/types": ["src/graphql/types"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "declarations.d.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules"]
}
